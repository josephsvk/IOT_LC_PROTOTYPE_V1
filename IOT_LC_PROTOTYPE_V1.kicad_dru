(version 1)


(rule "LOGIC_GND to 24V clearance"
    (condition "A.Net == 'LOGIC_GND' && B.Net == '24V'")
    (constraint clearance (min 0.5mm))
)
(rule "AC clearance"
  (constraint clearance (min 1.8mm))
  (condition "A.NetClass == 'HV_MAINS' && B.NetClass == 'HV_MAINS' && A.Net != B.Net")
)

(rule "AC creepage"
  (constraint creepage (min 3.2mm))
  (condition "A.NetClass == 'HV_MAINS' && B.NetClass == 'HV_MAINS' && A.Net != B.Net")
)
