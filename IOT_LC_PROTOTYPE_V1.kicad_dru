
(version 1)

# ==========================================
# 24V / LOGIC_GND
# ==========================================

(rule "LOGIC_GND to 24V clearance"
    (condition "A.Net == 'LOGIC_GND' && B.Net == '24V'")
    (constraint clearance (min 0.5mm))
)

# ==========================================
# 24V TRACK WIDTH
# ==========================================

(rule "24V_main_width"
    (condition "A.hasNetclass('PWR_24V')")
    (constraint track_width (min 1mm) (opt 1mm))
)

(rule "24V_neckdown"
    (condition "A.hasNetclass('PWR_24V') && A.intersectsArea('24V_NECKDOWN')")
    (constraint track_width (min 0.25mm) (opt 0.25mm))
)

# ==========================================
# 230V AC - CLEARANCE
# ==========================================

(rule "AC_main_clearance"
    (condition "A.hasNetclass('HV_MAINS') && B.hasNetclass('HV_MAINS') && A.Net != B.Net")
    (constraint clearance (min 3mm))
)

# ==========================================
# 230V AC - LOCAL CLEARANCE
# ==========================================

(rule "AC_local_2mm"
    (condition "A.hasNetclass('HV_MAINS') && B.hasNetclass('HV_MAINS') && A.Net != B.Net && A.intersectsArea('AC_2MM') && B.intersectsArea('AC_2MM')")
    (constraint clearance (min 2mm))
)

# ==========================================
# 230V AC - CREEPAGE
# ==========================================

(rule "AC_creepage"
    (condition "A.hasNetclass('HV_MAINS') && B.hasNetclass('HV_MAINS') && A.Net != B.Net")
    (constraint creepage (min 3.2mm))
)
